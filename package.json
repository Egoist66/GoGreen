{
  "name": "gogreen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,FRONT\" -c \"cyan,green\" \"bun run dev:api\" \"bun run dev:front\"",
    "dev:api": "bun --watch api/server.ts",
    "dev:front": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "start": "bun api/server.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vercel/blob": "^2.8.2",
    "@vueuse/core": "^15.0.0",
    "cors": "^2.8.6",
    "element-plus": "^2.14.7",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "bun"
    }
  }
}